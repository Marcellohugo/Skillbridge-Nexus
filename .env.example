# Copy this file to .env and replace every production secret before deploy.
# Docker Compose uses database host "db"; local npm dev may need localhost:5432 or localhost:5433.
POSTGRES_DB="kuchink_garonk"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"

DATABASE_URL="postgresql://postgres:replace-with-a-strong-database-password@db:5432/kuchink_garonk?schema=public"
JWT_SECRET="replace-with-a-random-secret-minimum-32-chars"
APP_URL="http://localhost:3000"

DEPLOYMENT_VERSION="local"
MIGRATE_ON_STARTUP="true"

# Email delivery. Use "console" for local/demo, "resend" for real production email.
EMAIL_PROVIDER="console"
EMAIL_FROM=""
RESEND_API_KEY=""

# Optional distributed login rate limiting for multi-instance production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
